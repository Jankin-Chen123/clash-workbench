PORT=3000
HOST=127.0.0.1
PUBLIC_URL=http://localhost:5173
# Leave empty for embedded PostgreSQL-compatible local storage.
DATABASE_URL=
# Required by Docker Compose. Use URL-safe random letters and digits.
POSTGRES_PASSWORD=
DATA_DIR=./data
# Production requires a persistent 32-byte key, expressed as 64 hexadecimal characters.
# Generate with node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=
# Defaults to ./bin/mihomo.exe on Windows and ./bin/mihomo on Linux/macOS.
MIHOMO_PATH=
# Optional private, trusted Sub-Store adapter. Never expose it on the public Internet.
SUBSTORE_URL=
# Exact trusted hostnames allowed to access private addresses, configured by the operator only.
TRUSTED_FETCH_HOSTS=
REFRESH_MINUTES=60
# Use 1 behind a single reverse proxy. Direct local access defaults to 0.
TRUST_PROXY_HOPS=0
